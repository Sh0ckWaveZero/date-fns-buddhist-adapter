{
  "name": "@midseelee/date-fns-buddhist-adapter",
  "repository": "git@github.com:Sh0ckWaveZero/date-fns-buddhist-adapter.git",
  "version": "1.2.0",
  "description": "date-fns adapter with Buddhist years functionality",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./date-range-picker": {
      "types": "./dist/date-range-picker/index.d.ts",
      "default": "./dist/date-range-picker/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "TZ=UTC jest",
    "test:watch": "TZ=UTC jest --watch",
    "test:coverage": "TZ=UTC jest --coverage",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsc --watch",
    "prepare": "husky install",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "lint": "prettier --check \"**/*.{md,yml,json}\" && eslint .",
    "lint:fix": "prettier --write \"**/*.{md,yml,json}\" && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "rebuild": "bun run clean && bun run build",
    "example:dev": "cd example && bun run dev",
    "example:install": "cd example && bun install",
    "example:build": "cd example && bun run build",
    "start": "bun src/index.ts"
  },
  "keywords": [
    "date",
    "date-fns",
    "date-io",
    "buddhist",
    "date-picker",
    "date-range-picker",
    "mui-x",
    "react"
  ],
  "author": "midseelee",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@date-io/date-fns": "3.2.1",
    "date-fns": "4.4.0"
  },
  "peerDependencies": {
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "react": "^19.3.0"
  },
  "overrides": {
    "@typescript-eslint/utils": "8.70.0",
    "brace-expansion": ">=1.1.13",
    "minimatch": ">=3.1.3",
    "diff": ">=4.0.4",
    "flatted": ">=3.4.0",
    "picomatch": ">=4.0.4",
    "js-yaml": ">=3.14.2"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint/js": "10.0.1",
    "@mui/material": "9.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@tsconfig/node-lts": "24.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
